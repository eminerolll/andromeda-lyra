# Lyra bootstrap configuration
# Bu dosyayi .env olarak kopyala ve degerleri kendine gore ayarla.
# Geri kalan tum ayarlar SQLite veritabaninda tutulur ve UI'dan veya
# `npm run setup` ile yapilandirilir.

# Veri klasoru: SQLite veritabani, sessions ve diger runtime data buraya yazilir.
LYRA_HOME=./data

# Launcher'in dinleyecegi port (loopback'e bind edilir).
LYRA_PORT=3000

# production | development
NODE_ENV=production
